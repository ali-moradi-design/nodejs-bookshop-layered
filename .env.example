PORT=4000
MONGODB_URI=mongodb://127.0.0.1:27017/bookstore
JWT_ACCESS_SECRET=change-me-access
JWT_REFRESH_SECRET=change-me-refresh
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=7d
NODE_ENV=development
# Explicit frontend origin(s) for cookie auth. Do not use * in production
# when credentials are enabled — browsers reject Access-Control-Allow-Origin: *.
# Comma-separated list is allowed. If set to *, the API reflects the request
# origin in development/test only.
# Defaults (when unset): Vite (:5173) and Next (:3000) on localhost + 127.0.0.1
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000
UPLOAD_DIR=uploads
# Cookie flags for accessToken / refreshToken (httpOnly always).
# COOKIE_SECURE defaults to true in production and false in development/test.
COOKIE_SECURE=false
# lax | strict | none  (none requires COOKIE_SECURE=true and HTTPS)
COOKIE_SAME_SITE=lax
# Optional; omit unless the API is served on a parent domain of the frontend.
# COOKIE_DOMAIN=

# Web Push (VAPID). Generate with: npx web-push generate-vapid-keys
# Do NOT commit real private keys. Placeholders only here.
VAPID_PUBLIC_KEY=replace-with-vapid-public-key
VAPID_PRIVATE_KEY=replace-with-vapid-private-key
VAPID_SUBJECT=mailto:admin@bookstore.local
